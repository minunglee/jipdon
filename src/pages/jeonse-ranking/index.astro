---
import Base from '../../layouts/Base.astro';
import DataAsOf from '../../components/DataAsOf.astro';
import Related from '../../components/Related.astro';
---

<Base
	title="전세가율 높은 동네 순위 (전국 아파트·빌라·오피스텔)"
	description="국토교통부 실거래가로 계산한 전국 동네별 전세가율 순위. 최근 12개월 매매가 대비 전세가가 높은 동네를 아파트·빌라·오피스텔별로 확인하세요."
>
	<h1>전세가율 높은 동네 순위</h1>
	<p class="lead">최근 12개월 실거래로 계산한 <strong>매매가 대비 전세가 비율</strong>이 높은 동네입니다. 전세가율이 높을수록 집값이 조금만 내려도 보증금을 돌려받기 어려워질 수 있습니다.</p>
	<DataAsOf />

	<form id="rank-form" class="card form" novalidate>
		<fieldset class="field" style="border: 0; padding: 0; margin: 0">
			<legend style="font-weight: 600; margin-bottom: 6px">주택 종류</legend>
			<div class="segmented">
				<input type="radio" id="k-apt" name="kind" value="APT" checked />
				<label for="k-apt">아파트</label>
				<input type="radio" id="k-rh" name="kind" value="RH" />
				<label for="k-rh">빌라</label>
				<input type="radio" id="k-offi" name="kind" value="OFFI" />
				<label for="k-offi">오피스텔</label>
			</div>
		</fieldset>
		<div class="field">
			<label for="sido">지역</label>
			<select id="sido" name="sido">
				<option value="">전국</option>
			</select>
		</div>
		<p id="rank-error" class="error" role="alert" hidden></p>
	</form>

	<section aria-live="polite">
		<h2 id="rank-title">전국 아파트</h2>
		<p class="muted" id="rank-info" style="margin-top: 0"></p>
		<div class="card table-wrap">
			<table class="rank-table">
				<thead>
					<tr><th>순위</th><th>동네</th><th>전세가율</th><th title="동 안 건물·면적 중 전세가율 80% 이상인 비율">80%↑</th><th>표본</th></tr>
				</thead>
				<tbody id="rank-rows">
					<tr><td colspan="5" class="muted">불러오는 중…</td></tr>
				</tbody>
			</table>
		</div>
		<p class="muted" style="font-size: 0.85rem">동네를 누르면 그 동의 건물별 전세가율을 볼 수 있습니다.</p>
	</section>

	<section class="explain">
		<h2>이렇게 계산했어요</h2>
		<ol>
			<li>건물마다 같은 전용면적 타입(소수점 버림)끼리 최근 12개월 <strong>매매 중앙값</strong>과 <strong>전세 중앙값</strong>을 구해 전세가율을 계산합니다.</li>
			<li>동 안에 있는 이 값들의 <strong>중앙값</strong>을 그 동의 전세가율로 봅니다.</li>
			<li>건물·면적 표본이 <strong>3개 미만</strong>인 동은 순위에서 뺍니다. 거래 한두 건으로 순위가 정해지지 않게 하려는 것입니다.</li>
			<li>전세가율이 20% 미만이거나 150%를 넘는 값은 지분 거래·공공임대 같은 특수한 경우로 보고 뺍니다.</li>
		</ol>
		<p class="formula">전세가율 = 전세 보증금 중앙값 ÷ 매매가 중앙값 × 100<br />80% 이상 = 그 동의 건물·면적 중 전세가율 80% 이상인 비율</p>

		<h2>이 순위를 볼 때 주의할 점</h2>
		<ul>
			<li>순위가 높다고 그 동네의 모든 집이 위험한 것은 아닙니다. 반대로 순위에 없어도 개별 집은 위험할 수 있습니다. 계약할 집은 반드시 <a href="/jeonse-risk/">건물별로 확인</a>하세요.</li>
			<li><strong>오피스텔</strong>은 원래 매매가가 잘 오르지 않아 전세가율이 높게 나오는 편입니다. 아파트·빌라와 따로 비교하세요.</li>
			<li>거래가 적은 지역은 표본이 적어 값이 크게 흔들릴 수 있습니다. 표본 수를 함께 보세요.</li>
			<li>전세가율에는 집에 걸린 대출(근저당)이 반영되지 않습니다. 등기부등본 확인은 꼭 필요합니다.</li>
		</ul>
		<p class="notice">국토교통부 실거래가 공개 자료로 계산한 참고 지표이며 특정 지역이나 주택의 안전을 보장하지 않습니다. 출처: 국토교통부 실거래가 공개시스템 (공공데이터포털)</p>
	</section>

	<Related />
</Base>

<script>
	type Kind = 'APT' | 'RH' | 'OFFI';
	interface Row {
		rank: number; regionCode: string; regionName: string; umd: string; ratio: number; samples: number;
		warningShare: number; saleCount: number; jeonseCount: number;
	}
	interface Ranking { kind: Kind; sido?: string; months: number; minSamples: number; computedAt?: string; since?: string; rows: Row[] }
	interface Region { code: string; sido: string; name: string }

	const API_BASE = import.meta.env.DEV ? 'http://localhost:8090' : '';
	const KIND_TEXT: Record<Kind, string> = { APT: '아파트', RH: '빌라', OFFI: '오피스텔' };
	const form = document.getElementById('rank-form') as HTMLFormElement;
	const sidoSelect = document.getElementById('sido') as HTMLSelectElement;
	const errorBox = document.getElementById('rank-error')!;
	const tbody = document.getElementById('rank-rows')!;
	let seq = 0;

	const el = <K extends keyof HTMLElementTagNameMap>(tag: K, text?: string, className?: string) => {
		const node = document.createElement(tag);
		if (text !== undefined) node.textContent = text;
		if (className) node.className = className;
		return node;
	};

	async function api<T>(path: string): Promise<T> {
		const res = await fetch(API_BASE + path, { headers: { Accept: 'application/json' } });
		if (!res.ok) {
			const body = await res.json().catch(() => ({}));
			throw new Error(body.message ?? '데이터를 불러오지 못했습니다.');
		}
		return res.json();
	}

	const level = (ratio: number) => (ratio >= 80 ? 'warning' : ratio >= 70 ? 'caution' : 'safe');

	function message(text: string) {
		const tr = el('tr');
		const td = el('td', text, 'muted');
		td.colSpan = 5;
		tr.append(td);
		tbody.replaceChildren(tr);
	}

	async function load() {
		const data = new FormData(form);
		const kind = data.get('kind') as Kind;
		const sido = String(data.get('sido') ?? '');
		const current = ++seq;
		document.getElementById('rank-title')!.textContent = `${sido || '전국'} ${KIND_TEXT[kind]}`;
		try {
			const params = new URLSearchParams({ kind });
			if (sido) params.set('sido', sido);
			const ranking = await api<Ranking>(`/api/rankings?${params}`);
			if (current !== seq) return;
			errorBox.hidden = true;
			const computed = ranking.computedAt ? new Date(ranking.computedAt).toLocaleString('ko-KR', { timeZone: 'Asia/Seoul' }) : '-';
			document.getElementById('rank-info')!.textContent =
				`${ranking.since ?? ''}부터 최근 ${ranking.months}개월 · 표본 ${ranking.minSamples}개 이상인 동 · 계산 ${computed}`;
			if (ranking.rows.length === 0) {
				message('표본이 충분한 동네가 없습니다.');
				return;
			}
			tbody.replaceChildren(
				...ranking.rows.map((r) => {
					const tr = el('tr', undefined, `level-${level(r.ratio)}`);
					const link = el('a', `${r.regionName} ${r.umd}`);
					link.href = `/jeonse-risk/?${new URLSearchParams({ region: r.regionCode, kind, q: r.umd })}`;
					const place = el('td');
					place.append(link);
					tr.append(
						el('td', String(r.rank)),
						place,
						el('td', `${r.ratio.toFixed(1)}%`, 'rank-ratio'),
						el('td', `${r.warningShare.toFixed(0)}%`),
						el('td', `${r.samples}개`),
					);
					return tr;
				}),
			);
		} catch (e) {
			if (current !== seq) return;
			errorBox.hidden = false;
			errorBox.textContent = (e as Error).message;
			message('불러오지 못했습니다.');
		}
	}

	async function loadSidos() {
		try {
			const regions = await api<Region[]>('/api/regions');
			for (const sido of [...new Set(regions.map((r) => r.sido))]) {
				const option = el('option', sido);
				option.value = sido;
				sidoSelect.append(option);
			}
		} catch {
			// 시·도 목록을 못 불러와도 전국 순위는 볼 수 있다
		}
	}

	form.addEventListener('submit', (e) => e.preventDefault());
	form.addEventListener('change', load);
	loadSidos();
	load();
</script>
