---
import Base from '../../layouts/Base.astro';
import RankingView from '../../components/RankingView.astro';
import { SIDOS } from '../../data/sidos';

// 기본은 서울. 다른 시도와 전국은 /jeonse-ranking/<지역>/
const seoul = SIDOS.find((s) => s.slug === 'seoul')!;
---

<Base
	title="서울 전세가율 높은 동네 순위 (아파트·빌라·오피스텔)"
	description="국토교통부 실거래가로 계산한 서울·전국 시도별 동네 전세가율 순위. 최근 12개월 매매가 대비 전세가가 높은 동네를 아파트·빌라·오피스텔별로 확인하세요. 매일 갱신."
>
	<RankingView sido={seoul} />
</Base>
