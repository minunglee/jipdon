---
import Base from '../../layouts/Base.astro';
import { GUIDES, GUIDES_CHECKED_AT, guideHref } from '../../data/guides';

const checked = new Date(GUIDES_CHECKED_AT).toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base title="집 계약 가이드 (공인중개사 자격 보유자가 정리한 전세 체크리스트)" description="깡통전세 판별법, 등기부등본 읽는 법, 전세 계약 체크리스트, 다가구 주의점, 전세보증보험, 중개보수까지. 공인중개사 자격 보유자가 법령 원문을 확인해 정리했습니다.">
	<h1>집 계약 가이드</h1>
	<p class="lead">전세 계약 전에 꼭 알아야 할 것들을 <strong>공인중개사 자격을 가진 운영자가 법령 원문을 확인해</strong> 정리했습니다. 집돈은 중개사무소가 아니며 매물 중개·광고를 하지 않습니다. 각 글은 집돈의 계산기·실거래 데이터와 연결되어 있어 읽고 바로 확인할 수 있습니다.</p>
	<p class="muted">법령 기준일: {checked}</p>
	<ul class="guide-index">
		{
			GUIDES.map((guide, i) => (
				<li>
					<a href={guideHref(guide)}>
						<span class="guide-no">{i + 1}</span>
						<span>
							<strong>{guide.title}</strong>
							<span class="guide-desc">{guide.desc}</span>
						</span>
					</a>
				</li>
			))
		}
	</ul>
</Base>

<style>
	.guide-index {
		display: grid;
		gap: 12px;
		margin: 24px 0 0;
		padding: 0;
		list-style: none;
	}

	.guide-index a {
		display: flex;
		gap: 14px;
		padding: 18px;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		color: var(--text);
		text-decoration: none;
	}

	.guide-index a:hover {
		border-color: var(--brand);
	}

	.guide-no {
		flex-shrink: 0;
		width: 28px;
		height: 28px;
		display: grid;
		place-items: center;
		background: var(--brand-tint);
		color: var(--brand-strong);
		border-radius: 999px;
		font-weight: 800;
	}

	.guide-desc {
		display: block;
		margin-top: 4px;
		color: var(--muted);
		font-size: 0.9rem;
	}
</style>
