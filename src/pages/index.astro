---
import Base from '../layouts/Base.astro';

import Assist from '../components/Assist.astro';
import ToolCard from '../components/ToolCard.astro';
import { TOOL_GROUPS, TOOLS } from '../data/tools';
import { GUIDES, guideHref } from '../data/guides';
---

<Base title="집·대출·차·투자, 큰돈 계산을 정확하게" description="적립식 투자, 자동차 할부, 대출 상환, DSR, 전세대출 이자, 중개보수, 전월세 전환까지. 계산식과 근거를 함께 보여주는 무료 계산기.">
	<section class="hero">
		<h1>집·대출·차·투자,<br />큰돈 계산을 정확하게</h1>
		<p class="lead">결과만 보여주지 않고, 어떻게 계산했는지와 주의할 점까지 함께 설명합니다.</p>
	</section>

	<Assist />

	<section class="feature" aria-labelledby="feature-title">
		<div>
			<span class="feature-tag">전국 256개 시군구 · 국토부 실거래가</span>
			<h2 id="feature-title">계약 전, 이 집 전세가율부터 확인하세요</h2>
			<p>아파트·빌라·오피스텔의 최근 매매가 대비 전세가를 건물별로 보여드립니다. 집값이 조금만 내려도 보증금이 위험한 깡통전세를 미리 피하세요.</p>
			<div class="feature-actions">
				<a class="primary" href="/jeonse-risk/">전세 위험 확인하기 →</a>
				<a class="ghost" href="/jeonse-ranking/">전세가율 높은 동네 순위</a>
			</div>
		</div>
		<svg class="feature-art" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="M12 3 4 6v6c0 4.5 3.4 8.2 8 9 4.6-.8 8-4.5 8-9V6z" />
			<path d="m9 12 2 2 4-4" />
		</svg>
	</section>

	<div id="tools">
		{
			TOOL_GROUPS.map((group) => (
				<section class="tool-group">
					<h2>{group.name}</h2>
					<div class="tools">
						{TOOLS.filter((tool) => tool.group === group.id).map((tool) => <ToolCard tool={tool} />)}
					</div>
				</section>
			))
		}
	</div>

	<section class="tool-group">
		<h2>집 계약 가이드 <small class="muted" style="font-weight: 400; font-size: 0.85rem">공인중개사 자격 보유자가 정리</small></h2>
		<ul class="home-guides">
			{GUIDES.map((guide) => <li><a href={guideHref(guide)}>{guide.title}</a></li>)}
		</ul>
	</section>

	<section class="explain">
		<h2>이런 점이 다릅니다</h2>
		<ul>
			<li><strong>계산 근거를 공개합니다.</strong> 각 계산기 아래에 공식, 반올림 기준, 관련 법령을 적어 두었습니다.</li>
			<li><strong>계산기에 입력한 값은 서버로 보내지 않습니다.</strong> 모든 계산은 이용자의 브라우저 안에서만 이루어집니다. (AI 안내에 적은 질문만 안내를 위해 보내고 저장하지 않습니다.)</li>
			<li><strong>회원가입이 필요 없습니다.</strong> 들어와서 바로 계산하면 됩니다.</li>
		</ul>
	</section>
</Base>

<style>
	.home-guides {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
		gap: 8px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.home-guides a {
		display: block;
		height: 100%;
		padding: 14px 16px;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		color: var(--text);
		font-weight: 600;
		text-decoration: none;
	}

	.home-guides a:hover {
		border-color: var(--brand);
	}
</style>
