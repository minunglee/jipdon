---
// 계산기 목록 카드 (메인 화면과 "다른 계산기"가 함께 쓴다)
import type { Tool, ToolIconName } from '../data/tools';

interface Props {
	tool: Tool;
}

const { tool } = Astro.props;

// 24×24 선 아이콘 (직접 그린 단순한 도형)
const ICONS: Record<ToolIconName, string> = {
	loan: '<rect x="3" y="6" width="18" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/><path d="M6 9v.01M18 15v.01"/>',
	house: '<path d="M3 11 12 4l9 7"/><path d="M5 10v10h14V10"/><path d="M10 20v-5h4v5"/>',
	receipt: '<path d="M6 3h12v18l-3-2-3 2-3-2-3 2z"/><path d="M9 8h6M9 12h6M9 16h3"/>',
	swap: '<path d="M4 8h15l-4-4"/><path d="M20 16H5l4 4"/>',
	shield: '<path d="M12 3 4 6v6c0 4.5 3.4 8.2 8 9 4.6-.8 8-4.5 8-9V6z"/><path d="m9 12 2 2 4-4"/>',
	car: '<path d="M5 16V11l2-5h10l2 5v5"/><path d="M3 16h18v2H3z"/><circle cx="7.5" cy="18.5" r="1.5"/><circle cx="16.5" cy="18.5" r="1.5"/><path d="M5 11h14"/>',
	chart: '<path d="M3 20h18"/><path d="m4 16 5-5 4 3 7-7"/><path d="M15 7h5v5"/>',
	pie: '<path d="M12 3a9 9 0 1 0 9 9h-9z"/><path d="M15 3.5A9 9 0 0 1 20.5 9H15z"/>',
};
---

<a class="tool" href={tool.href}>
	<span class="tool-icon" aria-hidden="true">
		<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS[tool.icon]} />
	</span>
	<strong>{tool.name}</strong>
	<span>{tool.desc}</span>
</a>
